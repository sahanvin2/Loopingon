generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions", "multiSchema"]
  binaryTargets   = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, pgcrypto, vector]
  schemas    = ["public", "auth"]
}

// ============ ENUMS ============

enum UserRole {
  SUPER_ADMIN
  ADMIN
  VENDOR
  CUSTOMER
  SUPPORT
  MODERATOR
  @@schema("public")
}

enum VendorStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  BANNED
  @@schema("public")
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  OUT_OF_STOCK
  DISCONTINUED
  FLAGGED
  @@schema("public")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
  COMPLETED
  @@schema("public")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  HELD_IN_ESCROW
  RELEASED_TO_VENDOR
  @@schema("public")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  @@schema("public")
}

enum ShippingMethod {
  STANDARD
  EXPRESS
  FREE
  SAME_DAY
  INTERNATIONAL
  PICKUP
  KOOMBIYO
  @@schema("public")
}

enum NotificationType {
  ORDER_CONFIRMATION
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_RECEIVED
  PAYOUT_PROCESSED
  NEW_MESSAGE
  NEW_REVIEW
  VENDOR_VERIFIED
  VENDOR_REJECTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  COMPETITION_ANNOUNCEMENT
  PROMOTIONAL
  SYSTEM_ALERT
  REMINDER
  REFERRAL_EARNED
  LOYALTY_POINTS
  @@schema("public")
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
  @@schema("public")
}

enum CompetitionStatus {
  UPCOMING
  ACTIVE
  JUDGING
  COMPLETED
  CANCELLED
  @@schema("public")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
  @@schema("public")
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  @@schema("public")
}

// ==================== USERS & AUTH ====================

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  emailVerified       Boolean    @default(false)
  emailVerifiedAt     DateTime?
  passwordHash        String?
  fullName            String
  firstName           String?
  lastName            String?
  phone               String?
  phoneVerified       Boolean    @default(false)
  avatar              String?
  role                UserRole   @default(CUSTOMER)
  twoFactorEnabled    Boolean    @default(false)
  twoFactorSecret     String?
  twoFactorBackupCodes String[]
  googleId            String?    @unique
  facebookId          String?    @unique
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  isActive            Boolean    @default(true)
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  sessions            Session[]
  refreshTokens       RefreshToken[]
  addresses           Address[]
  vendor              Vendor?
  customerProfile     CustomerProfile?
  orders              Order[]              @relation("OrderCustomer")
  reviews             Review[]
  wishlists           Wishlist[]
  cart                Cart?
  notifications       Notification[]
  messages            Message[]            @relation("MessageSender")
  messageThreads      MessageThread[]      @relation("ThreadParticipant")
  referralCode        ReferralCode?
  referralsMade       Referral[]           @relation("ReferralReferrer")
  referralsReceived   Referral[]           @relation("ReferralReferred")
  loyaltyAccount      LoyaltyAccount?
  competitionEntries  CompetitionEntry[]
  productInteractions ProductInteraction[]

  competitionVotes    CompetitionVote[]
  auditLogs           AuditLog[]
  supportTickets      SupportTicket[]      @relation("TicketCreator")
  supportReplies      SupportTicketReply[] @relation("ReplyUser")
  trackingSessions    TrackingSession[]
    searchQueries       SearchQuery[]


  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
  @@schema("public")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  deviceInfo   Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
  @@schema("public")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  family    String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([family])
  @@map("refresh_tokens")
  @@schema("public")
}

model Address {
  id             String    @id @default(uuid())
  userId         String
  label          String?
  fullName       String
  phone          String
  addressLine1   String
  addressLine2   String?
  city           String
  district       String
  province       String?
  postalCode     String?
  country        String    @default("LK")
  isDefault      Boolean   @default(false)
  isBilling      Boolean   @default(false)
  latitude       Float?
  longitude      Float?
  deliveryNotes  String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]   @relation("OrderShippingAddress")

  @@index([userId])
  @@map("addresses")
  @@schema("public")
}

model CustomerProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  dateOfBirth        DateTime?
  gender             String?
  preferredLanguage  String   @default("en")
  currency           String   @default("LKR")
  marketingOptIn     Boolean  @default(false)
  newsletterOptIn    Boolean  @default(false)
  interests          String[]
  totalOrders        Int      @default(0)
  totalSpent         Decimal  @default(0) @db.Decimal(12, 2)
  lifetimeValue      Decimal  @default(0) @db.Decimal(12, 2)
  lastOrderAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
  @@schema("public")
}

// ==================== VENDORS ====================

model Vendor {
  id                  String       @id @default(uuid())
  userId              String       @unique
  storeName           String       @unique
  storeSlug           String       @unique
  storeDescription    String
  storeLogo           String?
  storeBanner         String?
  storeSince          DateTime     @default(now())
  status              VendorStatus @default(PENDING)
  verificationNotes   String?
  verifiedAt          DateTime?
  verifiedBy          String?

  businessName        String?
  businessRegistrationNo String?
  businessType        String?
  taxId               String?
  craftType           String[]
  craftDescription    String?
  yearsOfExperience   Int?
  employeeCount       Int?
  workshopLocation    String?
  workshopCity        String?
  workshopDistrict    String?

  websiteUrl          String?
  facebookUrl         String?
  instagramUrl        String?
  youtubeUrl          String?
  tiktokUrl           String?

  totalProducts       Int          @default(0)
  totalOrders         Int          @default(0)
  totalRevenue        Decimal      @default(0) @db.Decimal(12, 2)
  rating              Float        @default(0)
  reviewCount         Int          @default(0)
  responseRate        Float        @default(0)
  avgResponseTime     Float        @default(0)
  onTimeDeliveryRate  Float        @default(0)
  returnRate          Float        @default(0)
  commissionRate      Float        @default(20.0)

  nextPayoutDate      DateTime?
  lastPayoutDate      DateTime?
  pendingPayoutAmount Decimal      @default(0) @db.Decimal(12, 2)
  totalPayoutAmount   Decimal      @default(0) @db.Decimal(12, 2)

  vacationMode        Boolean      @default(false)
  freeShippingEnabled Boolean      @default(false)
  freeShippingMinOrder Decimal?    @db.Decimal(10, 2)

  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankDetails         VendorBankDetail[]
  verificationDocs    VendorVerificationDoc[]
  storefrontSettings  StorefrontSettings?
  products            Product[]
  orders              Order[]      @relation("OrderVendor")
  reviewsReceived     Review[]
  analytics           VendorAnalytics[]
  payoutSchedules     PayoutSchedule[]

  @@index([storeSlug])
  @@index([status])
  @@index([craftType])
  @@index([rating])
  @@index([deletedAt])
  @@map("vendors")
  @@schema("public")
}

model VendorBankDetail {
  id              String   @id @default(uuid())
  vendorId        String
  bankName        String
  branchName      String
  accountHolderName String
  accountNumber   String   @unique
  accountType     String
  isPrimary       Boolean  @default(false)
  verifiedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_bank_details")
  @@schema("public")
}

model VendorVerificationDoc {
  id          String   @id @default(uuid())
  vendorId    String
  docType     String
  docUrl      String
  docName     String
  verifiedAt  DateTime?
  verifiedBy  String?
  notes       String?
  createdAt   DateTime @default(now())

  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_verification_docs")
  @@schema("public")
}

model StorefrontSettings {
  id              String  @id @default(uuid())
  vendorId        String  @unique
  themeColor      String?
  customCss       String?
  featuredProducts String[]
  aboutSection    String?
  policies        Json?
  storySection    String?
  videoUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor          Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("storefront_settings")
  @@schema("public")
}

model VendorAnalytics {
  id           String   @id @default(uuid())
  vendorId     String
  date         DateTime
  views        Int      @default(0)
  uniqueVisitors Int    @default(0)
  orders       Int      @default(0)
  revenue      Decimal  @default(0) @db.Decimal(12, 2)
  commission   Decimal  @default(0) @db.Decimal(12, 2)
  conversionRate Float  @default(0)
  avgOrderValue Decimal @default(0) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
  @@index([vendorId, date])
  @@map("vendor_analytics")
  @@schema("public")
}

// ==================== CATEGORIES ====================

model Category {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  description     String?
  image           String?
  icon            String?
  parentId        String?
  level           Int        @default(0)
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)
  isFeatured      Boolean    @default(false)
  metaTitle       String?
  metaDescription String?
  productCount    Int        @default(0)
  seoKeywords     String[]
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryTree")
  products        ProductCategory[]

  @@index([slug])
  @@index([parentId])
  @@index([level])
  @@map("categories")
  @@schema("public")
}

model ProductCategory {
  productId   String
  categoryId  String

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
  @@schema("public")
}

// ==================== PRODUCTS ====================

model Product {
  id                  String        @id @default(uuid())
  vendorId            String
  title               String
  slug                String        @unique
  description         String
  shortDescription    String?
  price               Decimal       @db.Decimal(10, 2)
  compareAtPrice      Decimal?      @db.Decimal(10, 2)
  costPrice           Decimal?      @db.Decimal(10, 2)
  currency            String        @default("LKR")
  quantity            Int           @default(1)
  sku                 String?
  status              ProductStatus @default(DRAFT)
  isFeatured          Boolean       @default(false)
  isHandmade          Boolean       @default(true)
  isCustomizable      Boolean       @default(false)
  isDigital           Boolean       @default(false)
  isEcoFriendly       Boolean       @default(false)
  isFairTrade         Boolean       @default(false)
  craftType           String?
  materials           String[]
  dimensions          Json?
  weight              Float?
  processingTime      Int?
  shippingPrice       Decimal?      @db.Decimal(10, 2)
  shippingPriceInternational Decimal? @db.Decimal(10, 2)
  freeShippingDomestic Boolean     @default(false)
  madeToOrder         Boolean       @default(false)
  maxOrderQuantity    Int?          @default(10)

  metaTitle           String?
  metaDescription     String?
  ogImage             String?

  viewsCount          Int           @default(0)
  salesCount          Int           @default(0)
  reviewCount         Int           @default(0)
  averageRating       Float         @default(0)
  wishlistCount       Int           @default(0)

  deletedAt           DateTime?
  publishedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  vendor              Vendor        @relation(fields: [vendorId], references: [id])
  categories          ProductCategory[]
  images              ProductImage[]
  videos              ProductVideo[]
  variants            ProductVariant[]
  tags                ProductTag[]
  reviews             Review[]
  orderItems          OrderItem[]
  wishlistItems       WishlistItem[]
  cartItems           CartItem[]
  inventoryLogs       InventoryLog[]
  competitionEntries  CompetitionEntry[]
  productInteractions ProductInteraction[]

  @@index([vendorId])
  @@index([slug])
  @@index([status])
  @@index([price])
  @@index([craftType])
  @@index([averageRating])
  @@index([salesCount])
  @@index([deletedAt])
  @@index([isFeatured, status])
  @@map("products")
  @@schema("public")
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  url        String
  thumbnail  String
  medium     String
  large      String
  alt        String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  width      Int?
  height     Int?
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
  @@schema("public")
}

model ProductVideo {
  id          String   @id @default(uuid())
  productId   String
  url         String
  thumbnailUrl String?
  duration    Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_videos")
  @@schema("public")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  name      String
  sku       String?
  price     Decimal? @db.Decimal(10, 2)
  quantity  Int      @default(0)
  attributes Json?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
  @@schema("public")
}

model ProductTag {
  id        String  @id @default(uuid())
  productId String
  tag       String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tag])
  @@index([productId])
  @@map("product_tags")
  @@schema("public")
}

model InventoryLog {
  id         String   @id @default(uuid())
  productId  String
  variantId  String?
  change     Int
  reason     String
  reference  String?
  createdAt  DateTime @default(now())

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_logs")
  @@schema("public")
}

// ==================== CART ====================

model Cart {
  id                  String     @id @default(uuid())
  userId              String     @unique
  abandonedEmailStage Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items               CartItem[]

  @@map("carts")
  @@schema("public")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
  @@schema("public")
}

// ==================== ORDERS ====================

model Order {
  id                   String       @id @default(uuid())
  orderNumber          String       @unique
  customerId           String
  vendorId             String
  status               OrderStatus  @default(PENDING_PAYMENT)
  subtotal             Decimal      @db.Decimal(12, 2)
  shippingCost         Decimal      @default(0) @db.Decimal(10, 2)
  taxAmount            Decimal      @default(0) @db.Decimal(10, 2)
  discountAmount       Decimal      @default(0) @db.Decimal(10, 2)
  couponCode           String?
  totalAmount          Decimal      @db.Decimal(12, 2)
  currency             String       @default("LKR")

  commissionRate       Float        @default(20.0)
  commissionAmount     Decimal      @default(0) @db.Decimal(12, 2)
  vendorPayoutAmount   Decimal      @default(0) @db.Decimal(12, 2)
  vendorPayoutStatus   PayoutStatus?

  shippingMethod       ShippingMethod?
  shippingAddressId    String
  trackingNumber       String?
  trackingUrl          String?
  courierName          String?
  estimatedDelivery    DateTime?
  actualDelivery       DateTime?
  shippingLabelUrl     String?

  customerNotes        String?
  giftMessage          String?
  isGift               Boolean      @default(false)
  giftWrap             Boolean      @default(false)

  paymentId            String?
  paymentMethod        String?
  paymentStatus        PaymentStatus @default(PENDING)
  paidAt               DateTime?

  contactNumberTwo     String?
  facebookPage         String?
  orderNote            String?

  processingAt         DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  cancelledBy          String?

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  customer             User         @relation("OrderCustomer", fields: [customerId], references: [id])
  vendor               Vendor       @relation("OrderVendor", fields: [vendorId], references: [id])
  shippingAddress      Address      @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  shipments            Shipment[]
  dispute              OrderDispute?
  couponUsages         CouponUsage[]
  paymentTransactions  PaymentTransaction[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
  @@index([vendorPayoutStatus])
  @@map("orders")
  @@schema("public")
}

model OrderItem {
  id           String    @id @default(uuid())
  orderId      String
  productId    String
  variantId    String?
  productTitle String
  productImage String?
  price        Decimal   @db.Decimal(10, 2)
  quantity     Int
  totalPrice   Decimal   @db.Decimal(12, 2)
  vendorId     String

  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
  @@schema("public")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
  @@schema("public")
}

model Shipment {
  id              String   @id @default(uuid())
  orderId         String
  courierName     String
  trackingNumber  String
  trackingUrl     String?
  status          String
  statusUpdatedAt DateTime?
  shippedAt       DateTime?
  estimatedDelivery DateTime?
  deliveredAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([trackingNumber])
  @@map("shipments")
  @@schema("public")
}

model OrderDispute {
  id          String       @id @default(uuid())
  orderId     String       @unique
  reason      String
  description String
  status      ReportStatus @default(PENDING)
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_disputes")
  @@schema("public")
}

// ==================== WISHLIST ====================

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  name      String         @default("My Wishlist")
  isPublic  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@map("wishlists")
  @@schema("public")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  addedPrice Decimal? @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
  @@schema("public")
}

// ==================== REVIEWS ====================

model Review {
  id          String   @id @default(uuid())
  productId   String
  orderId     String   @unique
  customerId  String
  vendorId    String
  rating      Int
  title       String?
  content     String?
  images      String[]
  isVerified  Boolean  @default(false)
  isHidden    Boolean  @default(false)
  hiddenReason String?
  helpfulCount Int     @default(0)
  notHelpfulCount Int  @default(0)
  vendorReply String?
  vendorRepliedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id])
  customer    User     @relation(fields: [customerId], references: [id])
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  @@index([productId])
  @@index([customerId])
  @@index([vendorId])
  @@index([rating])
  @@map("reviews")
  @@schema("public")
}

// ==================== MESSAGES ====================

model MessageThread {
  id              String    @id @default(uuid())
  subject         String?
  orderId         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastMessageAt   DateTime?
  lastMessage     String?

  participants    User[]    @relation("ThreadParticipant")
  messages        Message[]

  @@index([orderId])
  @@map("message_threads")
  @@schema("public")
}

model Message {
  id          String        @id @default(uuid())
  threadId    String
  senderId    String
  content     String
  attachments String[]
  isRead      Boolean       @default(false)
  readAt      DateTime?
  createdAt   DateTime      @default(now())

  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User          @relation("MessageSender", fields: [senderId], references: [id])

  @@index([threadId])
  @@index([senderId])
  @@map("messages")
  @@schema("public")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id              String             @id @default(uuid())
  userId          String
  type            NotificationType
  channel         NotificationChannel
  title           String
  body            String
  data            Json?
  isRead          Boolean            @default(false)
  readAt          DateTime?
  deliveredAt     DateTime?
  errorMessage    String?
  createdAt       DateTime           @default(now())

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
  @@schema("public")
}

// ==================== PAYMENTS ====================

model PaymentTransaction {
  id                String        @id @default(uuid())
  orderId           String?
  userId            String
  vendorId          String?
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("LKR")
  gatewayName       String
  gatewayTransactionId String?
  gatewayResponse   Json?
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?
  commissionAmount  Decimal       @default(0) @db.Decimal(12, 2)
  vendorAmount      Decimal       @default(0) @db.Decimal(12, 2)
  platformFee       Decimal       @default(0) @db.Decimal(12, 2)
  refundAmount      Decimal?      @db.Decimal(12, 2)
  refundedAt        DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payoutSchedule    PayoutSchedule?
  order             Order?             @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([gatewayTransactionId])
  @@index([createdAt])
  @@map("payment_transactions")
  @@schema("public")
}

model PayoutSchedule {
  id              String        @id @default(uuid())
  vendorId        String
  periodStart     DateTime
  periodEnd       DateTime
  totalOrders     Int           @default(0)
  totalRevenue    Decimal       @default(0) @db.Decimal(12, 2)
  totalCommission Decimal       @default(0) @db.Decimal(12, 2)
  payoutAmount    Decimal       @default(0) @db.Decimal(12, 2)
  status          PayoutStatus  @default(PENDING)
  transactionId   String?       @unique
  bankDetailUsed  String
  processedAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  transaction     PaymentTransaction? @relation(fields: [transactionId], references: [id])

  @@index([vendorId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("payout_schedules")
  @@schema("public")
}

// ==================== COUPONS ====================

model Coupon {
  id              String       @id @default(uuid())
  code            String       @unique
  description     String?
  discountType    DiscountType
  discountValue   Decimal      @db.Decimal(10, 2)
  minOrderAmount  Decimal?     @db.Decimal(10, 2)
  maxDiscountAmount Decimal?   @db.Decimal(10, 2)
  usageLimit      Int?
  usageCount      Int          @default(0)
  perUserLimit    Int?         @default(1)
  startsAt        DateTime?
  expiresAt       DateTime
  isActive        Boolean      @default(true)
  applicableProducts String[]
  applicableCategories String[]
  applicableVendors String[]
  forNewCustomersOnly Boolean  @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  usages          CouponUsage[]

  @@index([code])
  @@index([expiresAt])
  @@index([isActive])
  @@map("coupons")
  @@schema("public")
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  orderId   String
  discountAmount Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])

  @@unique([couponId, userId, orderId])
  @@map("coupon_usages")
  @@schema("public")
}

// ==================== REFERRALS ====================

model ReferralCode {
  id              String     @id @default(uuid())
  userId          String     @unique
  code            String     @unique
  totalReferrals  Int        @default(0)
  totalEarnings   Decimal    @default(0) @db.Decimal(10, 2)
  status          String     @default("active")
  joinedAt        DateTime?
  acceptedTermsAt DateTime?
  bankDetails     Json?
  createdAt       DateTime   @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals   Referral[]

  @@map("referral_codes")
  @@schema("public")
}

model Referral {
  id              String   @id @default(uuid())
  referrerId      String
  referredUserId  String
  referralCodeStr String
  referralCodeId  String?
  status          String   @default("pending")
  rewardAmount    Decimal? @db.Decimal(10, 2)
  rewardClaimed   Boolean  @default(false)
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  referrer        User         @relation("ReferralReferrer", fields: [referrerId], references: [id])
  referredUser    User         @relation("ReferralReferred", fields: [referredUserId], references: [id])
  referralCode    ReferralCode? @relation(fields: [referralCodeId], references: [id])

  @@unique([referredUserId])
  @@map("referrals")
  @@schema("public")
}

// ==================== LOYALTY ====================

model LoyaltyAccount {
  id              String              @id @default(uuid())
  userId          String              @unique
  totalSpent      Decimal             @default(0) @db.Decimal(12, 2)
  tier            String              @default("none")
  rewardBalance   Decimal             @default(0) @db.Decimal(10, 2)
  claimedAt       DateTime?
  claimedTier     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    LoyaltyTransaction[]

  @@map("loyalty_accounts")
  @@schema("public")
}

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  accountId   String
  amount      Decimal? @db.Decimal(10, 2)
  type        String
  tier        String?
  reference   String?
  description String
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  account     LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("loyalty_transactions")
  @@schema("public")
}

// ==================== COMPETITIONS ====================

model Competition {
  id              String            @id @default(uuid())
  title           String
  slug            String            @unique
  description     String
  bannerImage     String?
  craftType       String?
  theme           String?
  status          CompetitionStatus @default(UPCOMING)
  startDate       DateTime
  endDate         DateTime
  judgingStartDate DateTime?
  judgingEndDate  DateTime?
  prizeDescription String
  prizeValue      Decimal?          @db.Decimal(10, 2)
  rules           String
  maxEntries      Int               @default(100)
  entryFee        Decimal?          @default(0) @db.Decimal(10, 2)
  isFreeEntry     Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  entries         CompetitionEntry[]

  @@index([status])
  @@index([slug])
  @@map("competitions")
  @@schema("public")
}

model CompetitionEntry {
  id            String            @id @default(uuid())
  competitionId String
  userId        String
  productId     String
  title         String
  description   String
  images        String[]
  voteCount     Int               @default(0)
  status        String            @default("submitted")
  submittedAt   DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])

  votes         CompetitionVote[]

  @@unique([competitionId, productId])
  @@map("competition_entries")
  @@schema("public")
}

model CompetitionVote {
  id        String   @id @default(uuid())
  entryId   String
  userId    String
  createdAt DateTime @default(now())

  entry     CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id])

  @@unique([entryId, userId])
  @@map("competition_votes")
  @@schema("public")
}

// ==================== SUPPORT ====================

model SupportTicket {
  id          String                @id @default(uuid())
  ticketNumber String               @unique
  userId      String
  subject     String
  category    String
  priority    String                @default("normal")
  status      String                @default("open")
  orderId     String?
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user        User                  @relation("TicketCreator", fields: [userId], references: [id])
  replies     SupportTicketReply[]

  @@index([userId])
  @@index([status])
  @@index([ticketNumber])
  @@map("support_tickets")
  @@schema("public")
}

model SupportTicketReply {
  id          String        @id @default(uuid())
  ticketId    String
  userId      String
  content     String
  attachments String[]
  isInternal  Boolean       @default(false)
  createdAt   DateTime      @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User          @relation("ReplyUser", fields: [userId], references: [id])

  @@map("support_ticket_replies")
  @@schema("public")
}

// ==================== AUDIT ====================

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("public")
}

// ==================== CONTENT ====================

model Page {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  content       String
  metaTitle     String?
  metaDescription String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("pages")
  @@schema("public")
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  position    String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("banners")
  @@schema("public")
}

model BlogPost {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  excerpt         String?
  content         String
  featuredImage   String?
  authorId        String
  category        String?
  tags            String[]
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  viewCount       Int      @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@map("blog_posts")
  @@schema("public")
}

model SeoSetting {
  id          String   @id @default(uuid())
  page        String   @unique
  title       String
  description String
  keywords    String[]
  ogImage     String?
  canonicalUrl String?
  structuredData Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("seo_settings")
  @@schema("public")
}

model SitemapUrl {
  id          String   @id @default(uuid())
  url         String   @unique
  changefreq  String   @default("weekly")
  priority    Float    @default(0.5)
  lastmod     DateTime?
  createdAt   DateTime @default(now())

  @@map("sitemap_urls")
  @@schema("public")
}

model SystemSetting {
  id          String @id @default(uuid())
  key         String @unique
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @default(now())

  @@map("system_settings")
  @@schema("public")
}

model CommissionSetting {
  id              String   @id @default(uuid())
  name            String
  rate            Float
  minOrderAmount  Decimal? @db.Decimal(10, 2)
  maxOrderAmount  Decimal? @db.Decimal(10, 2)
  applicableTo    String[]
  isActive        Boolean  @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("commission_settings")
  @@schema("public")
}

model ShippingRate {
  id            String   @id @default(uuid())
  name          String
  courierName   String
  domesticRate  Decimal  @db.Decimal(10, 2)
  internationalRate Decimal @db.Decimal(10, 2)
  freeShippingMinAmount Decimal? @db.Decimal(10, 2)
  estimatedDays Int
  weightLimit   Float?
  isActive      Boolean  @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("shipping_rates")
  @@schema("public")
}

// ==================== ANALYTICS & TRACKING ====================

model TrackingSession {
  id          String   @id @default(uuid())
  cookieId    String   @unique
  userId      String?
  deviceType  String?
  browser     String?
  os          String?
  country     String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  pageVisits  PageVisit[]
  productInteractions ProductInteraction[]
  searchQueries SearchQuery[]

  @@index([cookieId])
  @@index([userId])
  @@map("tracking_sessions")
  @@schema("public")
}

model PageVisit {
  id             String   @id @default(uuid())
  sessionId      String
  userId         String?
  path           String
  title          String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  durationSeconds Int?     @default(0)
  maxScrollDepth Float?    @default(0)
  createdAt      DateTime @default(now())

  session        TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([path])
  @@index([createdAt])
  @@map("page_visits")
  @@schema("public")
}

enum InteractionType {
  VIEW
  ADD_TO_CART
  REMOVE_FROM_CART
  PURCHASE
  WISHLIST
  @@schema("public")
}

model ProductInteraction {
  id          String         @id @default(uuid())
  sessionId   String
  userId      String?
  productId   String
  type        InteractionType
  metadata    Json?
  createdAt   DateTime       @default(now())

  session     TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("product_interactions")
  @@schema("public")
}

model SearchQuery {
  id           String   @id @default(uuid())
  sessionId    String
  userId       String?
  query        String
  resultsCount Int      @default(0)
  filters      Json?
  createdAt    DateTime @default(now())

  session      TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([query])
  @@index([createdAt])
  @@map("search_queries")
  @@schema("public")
}
