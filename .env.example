# Database
DATABASE_URL=postgresql://user:password@localhost:5432/loopingon

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/v1/auth/facebook/callback

# Email (SMTP - Brevo / Sendinblue)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-user
SMTP_PASS=your-brevo-smtp-password
SMTP_SECURE=false
SMTP_FROM=Movia <no-reply@movia.club>
EMAIL_FROM=no-reply@movia.club

# SMS will be used for:
# - OTP verification during signup
# - Order status updates (shipped, delivered)
# - Payout notifications (balance reached, processed)
# - Promotional alerts (optional)

# WhatsApp (Twilio or Meta)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_BASE_URL=https://sandbox.payhere.lk

# Payable
PAYABLE_API_KEY=
PAYABLE_API_SECRET=

# Backblaze B2 Storage (S3-compatible)
STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
STORAGE_ACCESS_KEY=your-b2-access-key
STORAGE_SECRET_KEY=your-b2-secret-key
STORAGE_BUCKET=movia-prod
STORAGE_REGION=us-east-005
STORAGE_CDN_URL=https://f005.backblazeb2.com/file/movia-prod
B2_PUBLIC_BASE=https://f005.backblazeb2.com/file/movia-prod
CDN_URL=https://f005.backblazeb2.com/file/movia-prod

# AI (OpenAI)
OPENAI_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=https://kandyam.com/api/v1
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Platform
PLATFORM_COMMISSION_RATE=20
PLATFORM_MIN_PAYOUT=5000
PLATFORM_PAYOUT_SCHEDULE=threshold
PLATFORM_NAME=Kandyam
