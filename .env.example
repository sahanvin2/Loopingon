# Database
DATABASE_URL=postgresql://user:password@localhost:5432/loopingon

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4000/api/v1/auth/facebook/callback

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@kandyam.com

# Twilio (SMS notifications & OTP verification)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMS will be used for:
# - OTP verification during signup
# - Order status updates (shipped, delivered)
# - Payout notifications (balance reached, processed)
# - Promotional alerts (optional)

# WhatsApp (Twilio or Meta)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_BASE_URL=https://sandbox.payhere.lk

# Payable
PAYABLE_API_KEY=
PAYABLE_API_SECRET=

# DigitalOcean Spaces (S3)
SPACES_ENDPOINT=
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=loopingon-media
SPACES_REGION=sgp1

# AI (OpenAI)
OPENAI_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Platform
PLATFORM_COMMISSION_RATE=20
PLATFORM_MIN_PAYOUT=5000
PLATFORM_PAYOUT_SCHEDULE=threshold
PLATFORM_NAME=Kandyam
